        {
          "name": "16 - Capture Pending Pricing IDs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/admin/pricing"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function saveCsrf(html) {",
                  "    let m = html.match(/<meta[^>]+name=[\"']csrf-token[\"'][^>]+content=[\"']([^\"']+)[\"']/i);",
                  "    if (!m) m = html.match(/name=[\"']_token[\"'][^>]+value=[\"']([^\"']+)[\"']/i);",
                  "    if (!m) m = html.match(/value=[\"']([^\"']+)[\"'][^>]+name=[\"']_token[\"']/i);",
                  "    pm.test('CSRF token found', () => pm.expect(m).to.not.equal(null));",
                  "    if (m) pm.environment.set('csrf_token', m[1]);",
                  "}",
                  "saveCsrf(pm.response.text());",
                  "",
                  "pm.test('Pricing page returns 200', () => pm.response.to.have.status(200));",
                  "const html = pm.response.text();",
                  "",
                  "function capture(priceVar, idVar) {",
                  "    const price = '$' + Number(pm.collectionVariables.get(priceVar)).toFixed(2);",
                  "    const start = html.indexOf(price);",
                  "    pm.test(`${price} is pending`, () => pm.expect(start).to.be.above(-1));",
                  "",
                  "    if (start > -1) {",
                  "        const end = html.indexOf('</tr>', start);",
                  "        const row = html.slice(start, end > start ? end : start + 20000);",
                  "        const m = row.match(/\\/admin\\/pricing\\/(\\d+)\\/approve/);",
                  "        pm.test(`ID found for ${price}`, () => pm.expect(m).to.not.equal(null));",
                  "        if (m) pm.collectionVariables.set(idVar, m[1]);",
                  "    }",
                  "}",
                  "",
                  "capture('m2_approve_price', 'approve_submission_id');",
                  "capture('m2_reject_price', 'reject_submission_id');"
                ]
              }
            }
          ]
        },
