    {
      "name": "01 - Collector Milestone 2 Flow",
      "item": [
        {
          "name": "01 - Get Registration Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/register"
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now();",
                  "pm.collectionVariables.set('m2_collector_username', `postmanm2${runId}`);",
                  "pm.collectionVariables.set('m2_collector_email', `postman.m2.${runId}@example.com`);",
                  "pm.collectionVariables.set('m2_collector_password', 'password');",
                  "pm.collectionVariables.set('admin_email', 'admin@test.com');",
                  "pm.collectionVariables.set('admin_password', 'password');",
                  "pm.collectionVariables.set('m2_approve_price', (600 + ((runId % 10000) / 100)).toFixed(2));",
                  "pm.collectionVariables.set('m2_reject_price', (750 + ((runId % 10000) / 100)).toFixed(2));",
                  "pm.collectionVariables.set('m2_submission_date',",
                  "    new Date(Date.now() - 86400000).toISOString().slice(0, 10));",
                  "pm.collectionVariables.set('m2_admin_car_name', `Postman M2 Car ${runId}`);",
                  "pm.collectionVariables.set('m2_admin_car_updated_name', `Postman M2 Updated ${runId}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function saveCsrf(html) {",
                  "    let m = html.match(/<meta[^>]+name=[\"']csrf-token[\"'][^>]+content=[\"']([^\"']+)[\"']/i);",
                  "    if (!m) m = html.match(/name=[\"']_token[\"'][^>]+value=[\"']([^\"']+)[\"']/i);",
                  "    if (!m) m = html.match(/value=[\"']([^\"']+)[\"'][^>]+name=[\"']_token[\"']/i);",
                  "    pm.test('CSRF token found', () => pm.expect(m).to.not.equal(null));",
                  "    if (m) pm.environment.set('csrf_token', m[1]);",
                  "}",
                  "saveCsrf(pm.response.text());",
                  "",
                  "pm.test('Registration page returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
