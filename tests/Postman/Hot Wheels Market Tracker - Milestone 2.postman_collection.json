    {
      "name": "03 - Admin Car Management and Logs",
      "item": [
        {
          "name": "19 - Get Create Car Page",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/admin/cars/create"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function saveCsrf(html) {",
                  "    let m = html.match(/<meta[^>]+name=[\"']csrf-token[\"'][^>]+content=[\"']([^\"']+)[\"']/i);",
                  "    if (!m) m = html.match(/name=[\"']_token[\"'][^>]+value=[\"']([^\"']+)[\"']/i);",
                  "    if (!m) m = html.match(/value=[\"']([^\"']+)[\"'][^>]+name=[\"']_token[\"']/i);",
                  "    pm.test('CSRF token found', () => pm.expect(m).to.not.equal(null));",
                  "    if (m) pm.environment.set('csrf_token', m[1]);",
                  "}",
                  "saveCsrf(pm.response.text());",
                  "",
                  "pm.test('Create car page returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "20 - Create Admin Test Car",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/admin/cars",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_token",
                  "value": "{{csrf_token}}",
                  "type": "text"
                },
                {
                  "key": "model_name",
                  "value": "{{m2_admin_car_name}}",
                  "type": "text"
                },
                {
                  "key": "series_name",
                  "value": "Postman Test Series",
                  "type": "text"
                },
                {
                  "key": "release_year",
                  "value": "2026",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "TH",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Created by Milestone 2 Postman/Newman testing.",
                  "type": "text"
                },
                {
                  "key": "image",
                  "value": "",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin create car succeeds', () => pm.expect([200,302]).to.include(pm.response.code));",
                  "const html = pm.response.text();",
                  "const name = pm.collectionVariables.get('m2_admin_car_name');",
                  "const start = html.indexOf(name);",
                  "pm.test('Created car appears in admin list', () => pm.expect(start).to.be.above(-1));",
                  "",
                  "if (start > -1) {",
                  "    const segment = html.slice(start, start + 15000);",
                  "    const m = segment.match(/\\/admin\\/cars\\/(\\d+)\\/edit/);",
                  "    pm.test('Created car ID found', () => pm.expect(m).to.not.equal(null));",
                  "    if (m) pm.collectionVariables.set('admin_car_id', m[1]);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "21 - Update Admin Test Car",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/admin/cars/{{admin_car_id}}",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_token",
                  "value": "{{csrf_token}}",
                  "type": "text"
                },
                {
                  "key": "model_name",
                  "value": "{{m2_admin_car_updated_name}}",
                  "type": "text"
                },
                {
                  "key": "series_name",
                  "value": "Updated Postman Series",
                  "type": "text"
                },
                {
                  "key": "release_year",
                  "value": "2026",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "STH",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Updated by Milestone 2 Postman/Newman testing.",
                  "type": "text"
                },
                {
                  "key": "image",
                  "value": "",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin update car succeeds', () => pm.expect([200,302]).to.include(pm.response.code));",
                  "pm.test('Updated name appears', () => {",
                  "    pm.expect(pm.response.text()).to.include(pm.collectionVariables.get('m2_admin_car_updated_name'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "22 - Delete Admin Test Car",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{csrf_token}}"
              }
            ],
            "url": "{{base_url}}/admin/cars/{{admin_car_id}}",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_token",
                  "value": "{{csrf_token}}",
                  "type": "text"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin delete car succeeds', () => pm.expect([200,302]).to.include(pm.response.code));",
                  "pm.test('Deleted car no longer appears', () => {",
                  "    pm.expect(pm.response.text()).to.not.include(pm.collectionVariables.get('m2_admin_car_updated_name'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "23 - View System Error Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/admin/logs"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('System logs page returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('System Error Logs heading is visible', () => {",
                  "    pm.expect(pm.response.text()).to.include('System Error Logs');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
